{
  "name": "ecommerce-repuestos-taller",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "cd services/api && pnpm db:migrate",
    "db:seed": "cd services/api && pnpm db:seed",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "turbo": "^1.10.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
