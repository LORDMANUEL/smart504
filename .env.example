COMPOSE_PROJECT_NAME=smartdiag504
TZ=America/Tegucigalpa
ENVIRONMENT=production
SEED_DEMO_DATA=false
APP_IMAGE_TAG=0.4.0
PULL_POLICY=missing
HTTP_PORT=80
HTTPS_PORT=443

# Public DNS. Replace these values before production deployment.
ACME_EMAIL=admin@smartdiag504.com
PUBLIC_SITE_ADDRESS=smartdiag504.com
CUSTOMER_SITE_ADDRESS=clientes.smartdiag504.com
OPS_SITE_ADDRESS=app.smartdiag504.com
API_SITE_ADDRESS=api.smartdiag504.com
ERP_SITE_ADDRESS=admin.smartdiag504.com
# Compatibility aliases for external automation.
PUBLIC_DOMAIN=smartdiag504.com
CUSTOMER_DOMAIN=clientes.smartdiag504.com
OPS_DOMAIN=app.smartdiag504.com
ADMIN_DOMAIN=admin.smartdiag504.com
API_DOMAIN=api.smartdiag504.com
CORS_ORIGINS=https://smartdiag504.com,https://clientes.smartdiag504.com,https://app.smartdiag504.com

# Business identity shown by the public assistant.
BUSINESS_NAME="SmartDiag504"
BUSINESS_PHONE="+504 0000-0000"
BUSINESS_EMAIL=info@smartdiag504.com
BUSINESS_WHATSAPP_URL=https://wa.me/50400000000
BUSINESS_ADDRESS="San Pedro Sula, Honduras"
BUSINESS_HOURS=Lunes a sábado, horario por confirmar

# Frappe / ERPNext / Beveren FSM.
FRAPPE_SITE_NAME=admin.smartdiag504.com
ERP_SITE_NAME=admin.smartdiag504.com
FRAPPE_IMAGE=smartdiag504/frappe-workshop
FRAPPE_IMAGE_TAG=0.4.0
FRAPPE_PULL_POLICY=build
FRAPPE_BRANCH=v16.31.0
BEVEREN_REF=ab6d56d1069882326475f256d09cc63236eddec1
FRAPPE_ADMIN_PASSWORD=__GENERATE__
ERP_ADMIN_PASSWORD=__GENERATE__
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_PRICE_LIST="Standard Selling"
INVOICE_VERIFICATION_MODE=strict
OWNER_APPROVAL_EMAIL=admin@smartdiag504.com
APPROVAL_PUBLIC_BASE_URL=https://taller.nexusmedi.org
APPROVAL_EXPIRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=notificaciones@smartdiag504.com
MARIADB_ROOT_PASSWORD=__GENERATE__

# Platform transactional projection, events, catalog media metadata and chat.
POSTGRES_DB=smartdiag_platform
POSTGRES_USER=smartdiag
POSTGRES_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
ADMIN_API_TOKEN=__GENERATE__
CASHIER_ACCESS_CODE=__GENERATE_PRIVATE_PIN__
EVENT_HMAC_SECRET=__GENERATE__
CHAT_SESSION_SECRET=__GENERATE__
AI_GATEWAY_INTERNAL_TOKEN=__GENERATE__
# Compatibility names retained for integrations and repository gates.
WEBHOOK_SECRET=__GENERATE__
INTERNAL_API_KEY=__GENERATE__
NODE_A_ID=smartdiag-api-a
NODE_B_ID=smartdiag-api-b

# Public chatbot.
PUBLIC_CHAT_ENABLED=true
AI_GATEWAY_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=24
CHATBOT_SESSION_TTL_MINUTES=1440
CHATBOT_HISTORY_LIMIT=12
CHATBOT_RATE_LIMIT_MESSAGES=30
CHATBOT_RATE_WINDOW_SECONDS=3600
CHATBOT_WELCOME_MESSAGE=Hola, soy el asistente de SmartDiag504. Puedo orientarle sobre servicios, reservas, repuestos y el proceso de su vehículo.
CHATBOT_PRIVACY_NOTICE=La conversación se guarda temporalmente para atender su consulta. No comparta contraseñas, tarjetas ni datos bancarios.
CHATBOT_QUICK_PROMPTS=Reservar diagnóstico|Buscar repuesto|Consultar servicios|Contactar por WhatsApp
CHATBOT_QUICK_ACTION_CODES=BOOK_SERVICE|SEARCH_PARTS|CONTACT_WHATSAPP

# Product images: administrator upload is always available; Google CSE is optional.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
MAX_UPLOAD_MB=8
CAMPAIGN_MAX_UPLOAD_MB=25
# Opcional: lista exacta separada por |. Aunque se deje vacía, las descargas
# quedan fijadas a una IP pública validada para impedir DNS rebinding/SSRF.
REMOTE_IMAGE_ALLOWED_HOSTS=
MEDIA_BACKEND=filesystem
PUBLIC_MEDIA_BASE_URL=/media

# Garage S3-compatible evidence storage and optional media backend.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_BUCKET=smartdiag-evidence
PRIVATE_EVIDENCE_BACKEND=s3
GARAGE_RPC_SECRET=__GENERATE__
GARAGE_ADMIN_TOKEN=__GENERATE__
GARAGE_METRICS_TOKEN=__GENERATE__

# Optional LLM. demo works without an external API key.
LLM_PROVIDER=demo
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
OPENAI_API_KEY=
CHROMA_ENABLED=false
CHROMA_COLLECTION=smartdiag_knowledge

# Observability is loopback-only and starts with --profile observability.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=smartdiag-admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# Backups. Configure an off-VPS Restic repository before production.
BACKUP_DIR=/var/backups/smartdiag504
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=__GENERATE__
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# DEMO: los valores y credenciales actuales deben reemplazarse antes de producción.
PUBLIC_BOOKING_LIMIT_PER_MINUTE=5
PUBLIC_ORDER_LIMIT_PER_MINUTE=8
PUBLIC_LEAD_LIMIT_PER_MINUTE=5
PUBLIC_CHAT_SESSION_LIMIT_PER_MINUTE=6
PUBLIC_CHAT_MESSAGE_LIMIT_PER_MINUTE=12
